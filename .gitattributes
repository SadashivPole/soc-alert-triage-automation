# Shell scripts must stay LF-only in the working tree on every platform.
# Windows checkouts otherwise rewrite them to CRLF (core.autocrlf), and the
# BusyBox /bin/sh in n8nio/n8n:1.85.0 then fails to parse the mounted
# startup script (\"not found\"/syntax failures).
*.sh text eol=lf

# Wazuh integration scripts must stay LF-only — integratord cannot execute
# scripts with CRLF line endings.
wazuh/integrator/* text eol=lf
wazuh/entrypoint-scripts/* text eol=lf

# Python integration scripts must stay LF-only.
*.py text eol=lf
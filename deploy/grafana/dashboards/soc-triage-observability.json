          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (result) (rate(soc_triage_sweeper_passes_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "title": "Sweeper pass health",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 3, "x": 9, "y": 40 },
      "id": 13,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(soc_triage_incident_auto_close_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }

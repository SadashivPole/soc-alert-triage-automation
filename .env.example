# =============================================================================
# soc-alert-triage-automation — Environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# RULES
#   * `.env` is git-ignored. NEVER commit it, paste it, or log its contents.
#   * Every value below is a PLACEHOLDER or a safe local default.
#   * Optional services are DISABLED by default (empty value = disabled).
#   * For sharing configuration, share this template — never your `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# deployment mode: development | test | production
SOC_ENV=development
# log level: DEBUG | INFO | WARNING | ERROR
SOC_LOG_LEVEL=INFO
# unique deployment name used in logs / notifications (e.g. soc-lab)
SOC_INSTANCE_NAME=soc-lab

# -----------------------------------------------------------------------------
# Triage API (Python / FastAPI service)
# -----------------------------------------------------------------------------
TRIAGE_API_HOST=0.0.0.0
TRIAGE_API_PORT=8000
# Comma-separated list of allowed CORS origins (leave default for local lab)
TRIAGE_CORS_ORIGINS=http://localhost:8080
# SQLite by default; PostgreSQL profile available later (see ARCHITECTURE.md).
# The service applies Alembic migrations to this database automatically at
# startup; manage them manually with `alembic upgrade head` (see app/README.md).
TRIAGE_DB_URL=sqlite:////data/soc_triage.db
# Sliding deduplication window in seconds (Phase 1C). Distinct events from the
# same rule+agent within this window bump `occurrences` instead of creating new
# alerts; exact duplicate re-deliveries are idempotent within this horizon.
# Default: 900 (15 minutes). Must be >= 1.
TRIAGE_DEDUPE_WINDOW_SECONDS=900
# Cross-alert correlation window in seconds (Phase 6.4). Bounds *pairwise*
# correlation evidence: two distinct alerts (different dedupe groups) are
# comparable only when 0 <= newer.received_at - older.received_at <= window
# (inclusive boundary). A shared-indicator or same-host+technique pair older
# than this stays uncorrelated. Independent from the dedupe window above:
# recurrence and correlation answer different questions.
# Default: 900 (15 minutes). Must be >= 1.
TRIAGE_CORRELATION_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Incident auto-close TTL sweeper (Phase 3.4)
# -----------------------------------------------------------------------------
# Non-terminal incidents (open / investigating / acknowledged / escalated)
# whose `updated_at` has not changed within this TTL are automatically
# transitioned to `resolved` by the background sweeper. Terminal states
# (resolved, false_positive) are never touched.
# Default: 604800 (7 days) — conservative lab default; long enough for a
# typical analyst workflow in a portfolio/lab, short enough to keep the
# incident board from accumulating unbounded stale rows. Must be >= 1.
INCIDENT_AUTO_CLOSE_TTL_SECONDS=604800
# Period between background sweeper passes. Default: 300 (5 minutes). The
# sweeper is idempotent so a shorter interval is safe; this value bounds
# worst-case close latency without adding noticeable DB load. Must be >= 1.
INCIDENT_SWEEPER_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Prometheus metrics / observability (Phase 3.7, optional)
# -----------------------------------------------------------------------------
# Enable the metrics recording surface and the /metrics exposition on the
# Triage API (default: true). Metrics are non-load-bearing: setting this to
# 0 disables them without changing pipeline behavior.
METRICS_ENABLED=1
# OPTIONAL bearer token protecting GET /metrics (decision D1). EMPTY means
# metrics authentication is DISABLED (development-compatible default).
# When set, the scraper must send: Authorization: Bearer <this token>.
# This is a DEDICATED token — never reuse TRIAGE_INGEST_API_KEY or the N8N
# tokens for scraping. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# A `change-me-*` placeholder fails fast when SOC_ENV != development.
METRICS_SCRAPE_TOKEN=

# -----------------------------------------------------------------------------
# Authentication — ingest & service-to-service
# -----------------------------------------------------------------------------
# API key that Wazuh (or the test-data sender) must send as `X-API-Key`
# on POST /api/v1/alerts/ingest. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRIAGE_INGEST_API_KEY=change-me-generate-a-long-random-value
# Shared token that n8n uses when calling back into the Triage API
N8N_CALLBACK_TOKEN=change-me-generate-a-long-random-value

# -----------------------------------------------------------------------------
# Wazuh (Phase 4 — real manager integration; not needed for simulated alerts)
# -----------------------------------------------------------------------------
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USERNAME=change-me
WAZUH_API_PASSWORD=change-me
# Set to 1 to verify the Wazuh API TLS certificate (recommended; self-signed
# labs may need a mounted CA — see wazuh/README.md)
WAZUH_API_VERIFY_TLS=0

# --- Wazuh integrator (Phase 4.2 — wazuh/integrator/custom-triage) -----------
# The integrator forwards manager alerts to POST /api/v1/alerts/ingest using
# the EXISTING X-API-Key contract. It reads TRIAGE_API_BASE_URL and
# TRIAGE_INGEST_API_KEY (above) from this environment — never from ossec.conf.
# Minimum Wazuh rule level to forward (0-15).
WAZUH_INTEGRATOR_MIN_LEVEL=5
# Optional comma-separated noise filters (rule ids / rule groups) — not secrets.
WAZUH_INTEGRATOR_EXCLUDED_RULE_IDS=
WAZUH_INTEGRATOR_EXCLUDED_GROUPS=
# Per-attempt HTTP timeout and bounded retry budget before local buffering.
WAZUH_INTEGRATOR_TIMEOUT_SECONDS=5
WAZUH_INTEGRATOR_MAX_ATTEMPTS=3
WAZUH_INTEGRATOR_BACKOFF_SECONDS=0.5
# Local spool used when the API is temporarily unreachable (bounded on disk).
WAZUH_INTEGRATOR_SPOOL_DIR=/var/ossec/logs/triage-spool
WAZUH_INTEGRATOR_SPOOL_MAX_ENTRIES=1000
WAZUH_INTEGRATOR_SPOOL_MAX_AGE_SECONDS=604800
WAZUH_INTEGRATOR_SPOOL_FLUSH_BATCH=25
# Verify TLS when the ingest URL is https (1 recommended; 0 is lab-only).
WAZUH_INTEGRATOR_VERIFY_TLS=1
# Structured log sink. integratord discards stdout/stderr unless the manager
# runs at debug level, so the log file is the real observability channel.
WAZUH_INTEGRATOR_LOG_FILE=/var/ossec/logs/integrations.log

# -----------------------------------------------------------------------------
# VirusTotal enrichment (optional — PUBLIC API tier, lab/non-commercial only)
# -----------------------------------------------------------------------------
# Empty = enrichment disabled and the pipeline continues un-enriched.
# The free VirusTotal Public API is licensed for **lab / non-commercial use
# only** (https://support.virustotal.com — Public API terms). Do NOT use it for
# production or commercial workloads; obtain a licensed/premium key instead.
# Public tier limits: 4 requests/minute, 500/day — the provider rate-limits
# itself with a non-blocking token bucket (4 req/min, burst of 4) and never
# blocks the alert pipeline. Never commit or share any key here.
VIRUSTOTAL_API_KEY=

# -----------------------------------------------------------------------------
# MISP threat intel (optional — self-hosted MISP, free & open source)
# -----------------------------------------------------------------------------
# Empty URL or key = MISP lookups disabled (both are required to enable).
# The key has no placeholder: an unset/empty value is the documented "disabled"
# default, and a placeholder would trip the fail-fast secret check.
MISP_URL=
MISP_API_KEY=
# Set to 0 only for local lab instances with self-signed certificates
MISP_VERIFY_TLS=1

# -----------------------------------------------------------------------------
# MISP `intel` compose profile (Phase 2.4 — optional, operator-supplied)
# -----------------------------------------------------------------------------
# `docker compose --profile intel up -d` starts a self-hosted MISP stack on the
# internal `soc-core` network (no host ports). Each value below is a secret and
# must be generated locally — never commit a real value.
#
# Leave the whole block empty if you never enable the profile: required-value
# interpolation is deliberately not used (Compose interpolates the entire file
# before profile filtering, so it would break the default stack). Instead the
# profile's one-shot `misp-preflight` container aborts `--profile intel up -d`
# with an explicit message naming every missing variable, so MISP can never boot
# with its own upstream default credentials. See misp/seeding.md for the flow.
#
# Internal-only instance URL (the platform reaches MISP through misp-nginx).
MISP_BASE_URL=http://misp-nginx:8080
# MISP user #1 — used once at first boot to initialize the instance.
MISP_ADMIN_EMAIL=
MISP_ADMIN_ORG=
MISP_ADMIN_PASSWORD=
# The API key for user #1: set this AND MISP_API_KEY to the same value so the
# seeded instance is deterministic (misp/seeding.md step 1).
MISP_ADMIN_KEY=
MISP_GPG_PASSPHRASE=
MISP_ENCRYPTION_KEY=
# MariaDB / Valkey credentials for the MISP stack.
MISP_DB_USER=misp
MISP_DB_NAME=misp
MISP_DB_PASSWORD=
MISP_DB_ROOT_PASSWORD=
MISP_REDIS_PASSWORD=
# Optional sizing knobs (defaults target a workstation-sized lab).
MISP_INNODB_BUFFER_POOL_SIZE=512M
MISP_REDIS_MAXMEMORY=256mb

# Static local IOC allowlist (Phase 2.2)
# Optional. Empty = allowlist policy disabled.
# Example: app/config/allowlists.yaml
TRIAGE_ALLOWLIST_PATH=

# Static asset inventory (Phase 2.2)
# Optional. Empty = asset inventory policy disabled.
# Example: app/config/asset_inventory.yaml
TRIAGE_ASSET_INVENTORY_PATH=

# -----------------------------------------------------------------------------
# Enrichment response TTL cache (Phase 2.3 — optional, disabled by default)
# -----------------------------------------------------------------------------
# SQLite-backed cache for threat-intel responses (ARCHITECTURE.md §7.2 step 2).
# When enabled, definitive verdicts (found / not_found) are replayed
# byte-identically until their per-type TTL expires, so repeat indicators do
# not burn VirusTotal/MISP quota — a cache hit consumes no rate-limiter token.
# Errors, timeouts and rate-limited lookups are NEVER cached (they stay
# retryable). The cache is fail-open (a cache failure degrades to a normal
# lookup) and never feeds scoring or decisions on its own.
TRIAGE_ENRICHMENT_CACHE_ENABLED=0
# Hard cap on cached rows; overflow evicts the soonest-expiring entries.
TRIAGE_ENRICHMENT_CACHE_MAX_ENTRIES=4096
# Per-type TTLs. ARCHITECTURE.md §7.2 pins 6 h (21600 s) for hashes and
# 1 h (3600 s) for IPs; the default TTL covers domain / URL / email.
TRIAGE_ENRICHMENT_CACHE_HASH_TTL_SECONDS=21600
TRIAGE_ENRICHMENT_CACHE_IPV4_TTL_SECONDS=3600
TRIAGE_ENRICHMENT_CACHE_DEFAULT_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Automatic late-enrichment trigger (Phase 2.7A — optional, disabled by default)
# -----------------------------------------------------------------------------
# Background loop that re-runs the enrichment chain over recently persisted
# alerts and re-assesses (re-score, re-decide, re-persist) exactly those
# whose enrichment changed since the initial assessment — a late threat-intel
# verdict, a retried failed lookup, or a newly enabled provider. Idempotent
# (timestamp-insensitive enrichment fingerprint: the same enrichment never
# re-scores an alert twice), bounded (lookback window + 200 alerts per pass,
# oldest first), fail-open, and it never touches the ingest request path.
# Disabled by default so an unconfigured deployment performs zero external
# calls (ARCHITECTURE.md §7.3). Re-assessments are persisted + audited only;
# the sweep sends no additional n8n notifications (Phase 2.7B scope).
LATE_ENRICHMENT_SWEEP_ENABLED=0
# Seconds between sweep passes (also the retry cadence for failed lookups).
LATE_ENRICHMENT_SWEEP_INTERVAL_SECONDS=300
# Only alerts received within this window (in seconds) are sweep candidates.
LATE_ENRICHMENT_LOOKBACK_SECONDS=604800

# -----------------------------------------------------------------------------
# n8n (workflow orchestration)
# -----------------------------------------------------------------------------
# REQUIRED by n8n to encrypt stored credentials. Generate ONCE and keep stable:
#   openssl rand -hex 24
# Compose interpolates this value (no hardcoded default in docker-compose.yml).
# Changing N8N_ENCRYPTION_KEY while reusing the existing Docker volume `n8n-data`
# causes n8n to crash with "Mismatching encryption keys". The lab does NOT
# delete that volume automatically. To rotate the key you must create a fresh
# volume (docker volume rm …) after an explicit operator decision, then
# re-import workflows. A first start with an empty volume initializes cleanly.
N8N_ENCRYPTION_KEY=change-me-generate-and-keep-stable
N8N_HOST=http://localhost:5678
# Timezone used for schedules and escalation timers
GENERIC_TIMEZONE=UTC
# Local timezone for human-readable notifications (e.g. Asia/Kolkata, UTC)
SOC_DISPLAY_TIMEZONE=UTC

# Triage API → n8n outbound webhook (Phase 2B)
# Empty = n8n notifications disabled (fail-open, alert still accepted).
# When set, the triage service POSTs structured alert payloads (no full_log,
# no secrets) with timeout/retry and audits the result.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/soc-alert-scored
# Shared authentication token between triage service and n8n (Phase 2B).
# If N8N_WEBHOOK_TOKEN is empty, N8N_CALLBACK_TOKEN is used as shared token.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_WEBHOOK_TOKEN=change-me-generate-a-long-random-value
# Outbound webhook resilience (Phase 2B)
N8N_TIMEOUT_SECONDS=3.0
N8N_MAX_RETRIES=3
N8N_RETRY_BACKOFF_SECONDS=0.5
# Base URL used inside n8n workflows to call back into triage-api and to
# build investigation links (internal Docker DNS when both in compose)
TRIAGE_API_URL=http://triage-api:8000
TRIAGE_API_BASE_URL=http://triage-api:8000
# Base URL for outbound webhooks registered by n8n workflows
N8N_WEBHOOK_BASE_URL=http://n8n:5678

# -----------------------------------------------------------------------------
# Analyst notifications (optional — leave empty to disable a channel)
# -----------------------------------------------------------------------------
# SMTP (in the lab this points at the local Mailpit sink; never a real relay)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=soc-triage@lab.internal
SMTP_USER=
SMTP_PASSWORD=
# Single-recipient values used by the checked-in n8n workflows ($env.* refs).
# Keep the aliases below too because older compose configurations use them.
SOC_FROM_EMAIL=soc-triage@lab.internal
SOC_L1_EMAIL=analyst1@lab.internal
SOC_L2_EMAIL=l2@lab.internal
SLACK_CHANNEL_L1=#soc-l1
# Comma-separated analyst mailbox list for alert notifications
SOC_ANALYST_EMAILS=analyst1@lab.internal,analyst2@lab.internal
# Generic incoming-webhook URL (Slack/Discord/Teams-compatible), set in n8n
CHAT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Optional: TheHive 5 Community Edition incident case management (later phase)
# -----------------------------------------------------------------------------
# TheHive CE is free and self-hosted. TheHive Premium is NOT required.
THEHIVE_URL=
THEHIVE_API_KEY=change-me-if-enabled

# -----------------------------------------------------------------------------
# Optional: LLM-assisted triage summaries (EXPERIMENTAL, later phase)
# -----------------------------------------------------------------------------
# Leave empty to keep the pipeline fully deterministic.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=change-me-if-enabled

# =============================================================================
# End of template — remember: `git status` must never show a real .env file.
# =============================================================================

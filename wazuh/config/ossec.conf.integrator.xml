<!--
  Wazuh manager configuration fragment — Triage API integration (Phase 4.1/4.2).

  Mounted into the `full` compose profile at
  /wazuh-config-mount/etc/ossec.conf.d/ (see docker-compose.yml) and documented
  in wazuh/README.md. Merge the <integration> block below into the manager's
  <ossec_config> section.

  SECRETS: no api_key value is written here on purpose. The `custom-triage`
  script reads TRIAGE_API_BASE_URL and TRIAGE_INGEST_API_KEY from the manager
  container's environment (ARCHITECTURE.md §14, SECURITY.md §3). ossec.conf is
  world-readable inside the container, so a key placed here would be an at-rest
  secret. The placeholder below is a required-by-schema literal, not a
  credential.

  DEFENSIVE ONLY: this file configures detection forwarding only. It must never
  gain a response/containment block; containment stays a human-approved
  proposal (SECURITY.md §1).
-->
<ossec_config>

  <integration>
    <name>custom-triage</name>
    <!-- Informational only; the script derives the real endpoint from
         TRIAGE_API_BASE_URL + /api/v1/alerts/ingest. -->
    <hook_url>http://triage-api:8000/api/v1/alerts/ingest</hook_url>
    <!-- Not a secret: the script ignores this argument and uses the
         TRIAGE_INGEST_API_KEY environment variable instead. -->
    <api_key>env:TRIAGE_INGEST_API_KEY</api_key>
    <!-- Coarse manager-side filter; the script re-applies
         WAZUH_INTEGRATOR_MIN_LEVEL and the exclusion lists. -->
    <level>5</level>
    <alert_format>json</alert_format>
  </integration>

</ossec_config>
